# HQ collector endpoint the scouts report to
COLLECTOR_URL=http://localhost:9000/events

# ClickHouse Cloud (HTTP interface). Leave blank to run in-memory only.
CLICKHOUSE_URL=
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=default

# AkashML (OpenAI-compatible). Leave blank to use the built-in deterministic fix.
AKASH_BASE_URL=https://api.akashml.com/v1
AKASH_API_KEY=
AKASH_MODEL=

# GitHub repo the agent opens the PR against (owner/repo you OWN).
# Leave blank to skip the real PR and just print the patch + branch.
GH_REPO=
